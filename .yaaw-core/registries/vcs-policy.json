{
  "schema": "yaaw.vcs-policy/v1",
  "project_mode": {
    "marker": ".yaaw/install.json",
    "required_mode": "project",
    "required_vcs_isolation": "enabled"
  },
  "staging": {
    "strategy": "explicit-paths-only",
    "forbidden_commands": ["git add .", "git add -A", "git add --all"]
  },
  "publication": {
    "default_allowed_branches": ["main"],
    "require_same_source_and_destination": true,
    "topic_branches_remote_publication": "forbidden",
    "worktree_branches_remote_publication": "forbidden",
    "tags": "not_supported"
  },
  "bypass": {
    "forbidden": ["--no-verify", "--force", "--force-with-lease"]
  },
  "commit_messages": {
    "internal_patterns": [
      "(?i)\\bTASK-[0-9]+\\b",
      "(?i)\\bSPEC-[0-9]+\\b",
      "(?i)\\bENG-[0-9]+\\b",
      "(?i)\\bYAAW\\b",
      "(?i)review[ -]round",
      "(?i)ticket[ -]completed",
      "(?i)TASK[ -]done"
    ]
  },
  "history": {
    "reviewed_commit_rewrite": "invalidates_review",
    "scan_every_outgoing_commit": true,
    "non_fast_forward_publication": "forbidden"
  },
  "control_plane": {
    "always_local_patterns": [".yaaw/**", ".yaaw-core/**", "skills/yaaw-*/**"],
    "shared_paths_require_manifest_ownership": ["docs/**", "AGENTS.md", ".codex/**"]
  }
}
