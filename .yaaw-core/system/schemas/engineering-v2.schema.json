{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.engineering/v2",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "status",
    "product_revision",
    "current_frontier",
    "readiness",
    "scope_status"
  ],
  "properties": {
    "schema": {
      "const": "yaaw.engineering/v2"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "discovery",
        "questions",
        "ready",
        "blocked"
      ]
    },
    "product_revision": {
      "type": "integer",
      "minimum": 1
    },
    "current_frontier": {
      "type": [
        "string",
        "null"
      ]
    },
    "readiness": {
      "enum": [
        "pending",
        "PASS",
        "MISSING_DECISIONS",
        "PRODUCT_GAP",
        "REPLAN",
        "BLOCKED"
      ]
    },
    "scope_status": {
      "enum": [
        "UNKNOWN",
        "OPEN",
        "COMPLETE"
      ]
    },
    "revision_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revision",
          "impact",
          "reason"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 2
          },
          "impact": {
            "enum": [
              "NONE",
              "SCOPED",
              "ALL"
            ]
          },
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ENG-[0-9]+$"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "planning_next": {
      "type": "object",
      "required": [
        "workflow",
        "product_revision",
        "engineering_revision",
        "status",
        "current_frontier",
        "readiness",
        "reason"
      ],
      "properties": {
        "workflow": {
          "enum": [
            "planning.discover",
            "planning.write-understanding",
            "planning.decision-frontier",
            "planning.research",
            "planning.question-round",
            "planning.record-decisions",
            "planning.readiness-review"
          ]
        },
        "product_revision": {
          "type": "integer",
          "minimum": 1
        },
        "engineering_revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "discovery",
            "questions",
            "ready",
            "blocked"
          ]
        },
        "current_frontier": {
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "enum": [
            "pending",
            "PASS",
            "MISSING_DECISIONS",
            "PRODUCT_GAP",
            "REPLAN",
            "BLOCKED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "revision_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticket",
          "basis",
          "result",
          "reason",
          "evidence",
          "missing_evidence"
        ],
        "properties": {
          "ticket": {
            "type": "string",
            "pattern": "^TASK-[0-9]+$"
          },
          "basis": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "result": {
            "enum": [
              "CURRENT",
              "INVALIDATED",
              "INSUFFICIENT_PROVENANCE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missing_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
