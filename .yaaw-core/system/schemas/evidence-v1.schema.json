{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.evidence/v1",
  "type": "object",
  "required": ["schema","id","ticket","ticket_revision","spec_revision","kind","repository","workflow","commands","checks"],
  "properties": {
    "schema": {"const": "yaaw.evidence/v1"},
    "id": {"type": "string"},
    "ticket": {"type": "string", "pattern": "^TASK-[0-9]+$"},
    "ticket_revision": {"type": "integer", "minimum": 0},
    "spec_revision": {"type": "integer", "minimum": 0},
    "kind": {"type": "string"},
    "repository": {
      "type": "object",
      "required": ["head_commit","dirty","worktree_digest"],
      "properties": {
        "head_commit": {"type": ["string","null"]},
        "dirty": {"type": ["boolean","null"]},
        "worktree_digest": {"type": ["string","null"]}
      },
      "additionalProperties": false
    },
    "workflow": {"type": "string"},
    "commands": {"type": "array"},
    "checks": {"type": "array"}
  },
  "additionalProperties": false
}
