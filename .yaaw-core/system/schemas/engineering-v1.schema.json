{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.engineering/v1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "status",
    "product_revision",
    "current_frontier",
    "readiness"
  ],
  "properties": {
    "schema": {
      "const": "yaaw.engineering/v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "discovery",
        "questions",
        "ready",
        "blocked"
      ]
    },
    "product_revision": {
      "type": "integer",
      "minimum": 1
    },
    "current_frontier": {
      "type": [
        "string",
        "null"
      ]
    },
    "readiness": {
      "enum": [
        "pending",
        "PASS",
        "MISSING_DECISIONS",
        "PRODUCT_GAP",
        "REPLAN",
        "BLOCKED"
      ]
    },
    "revision_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticket",
          "basis",
          "result",
          "reason",
          "evidence",
          "missing_evidence"
        ],
        "properties": {
          "ticket": {
            "type": "string",
            "pattern": "^TASK-[0-9]+$"
          },
          "basis": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "result": {
            "enum": [
              "CURRENT",
              "INVALIDATED",
              "INSUFFICIENT_PROVENANCE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missing_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
