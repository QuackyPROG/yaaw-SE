{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.review/v2",
  "type": "object",
  "required": [
    "schema",
    "ticket",
    "round",
    "result",
    "ticket_revision",
    "spec_revision",
    "repository",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "yaaw.review/v2"
    },
    "ticket": {
      "type": "string",
      "pattern": "^TASK-[0-9]+$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "result": {
      "enum": [
        "PASS",
        "REPAIR",
        "REPLAN",
        "BLOCKED"
      ]
    },
    "ticket_revision": {
      "type": "integer",
      "minimum": 0
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 0
    },
    "repository": {
      "$ref": "repository-identity.schema.json"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scope_verified": {
      "type": "boolean"
    },
    "scope_identity": {
      "type": "object",
      "required": [
        "schema",
        "algorithm",
        "status",
        "paths",
        "digest",
        "files"
      ],
      "properties": {
        "schema": {
          "const": "yaaw.scope-identity/v1"
        },
        "algorithm": {
          "const": "yaaw-scope-v1"
        },
        "status": {
          "const": "READY"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
