{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.evidence/v3",
  "type": "object",
  "required": [
    "schema",
    "id",
    "ticket",
    "ticket_revision",
    "spec_revision",
    "kind",
    "result",
    "repository",
    "workflow",
    "commands",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "yaaw.evidence/v3"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "type": "string",
      "pattern": "^TASK-[0-9]+$"
    },
    "ticket_revision": {
      "type": "integer",
      "minimum": 0
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "implementation_start",
        "implementation_verification"
      ]
    },
    "result": {
      "enum": [
        "STARTED",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "repository": {
      "$ref": "repository-identity.schema.json"
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array"
    },
    "checks": {
      "type": "array"
    },
    "scope_identity": {
      "type": "object",
      "required": [
        "schema",
        "algorithm",
        "status",
        "paths",
        "digest",
        "files"
      ],
      "properties": {
        "schema": {
          "const": "yaaw.scope-identity/v1"
        },
        "algorithm": {
          "const": "yaaw-scope-v1"
        },
        "status": {
          "const": "READY"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "implementation_start"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "const": "STARTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "implementation_verification"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
