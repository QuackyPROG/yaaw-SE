{
  "schema": "yaaw.transitions/v1",
  "ticket_states": [
    "DRAFT",
    "READY",
    "IN_PROGRESS",
    "REVIEW_REQUIRED",
    "REPAIR_REQUIRED",
    "REPLAN_REQUIRED",
    "BLOCKED",
    "PASS",
    "CANCELLED"
  ],
  "legal": [
    {
      "from": "DRAFT",
      "to": "READY",
      "owner": "planner",
      "workflow": "planning.create-tickets",
      "state_writer": "orchestrator"
    },
    {
      "from": "DRAFT",
      "to": "CANCELLED",
      "owner": "planner",
      "workflow": "planning.replan",
      "state_writer": "orchestrator"
    },
    {
      "from": "READY",
      "to": "IN_PROGRESS",
      "owner": "implementer",
      "workflow": "implementation.implement-ticket",
      "state_writer": "orchestrator"
    },
    {
      "from": "READY",
      "to": "REPLAN_REQUIRED",
      "owner": "planner",
      "workflow": "planning.replan",
      "state_writer": "orchestrator"
    },
    {
      "from": "IN_PROGRESS",
      "to": "REVIEW_REQUIRED",
      "owner": "implementer",
      "workflow": "implementation.verify-ticket",
      "state_writer": "orchestrator"
    },
    {
      "from": "IN_PROGRESS",
      "to": "REPLAN_REQUIRED",
      "owner": "planner",
      "workflow": "planning.replan",
      "state_writer": "orchestrator"
    },
    {
      "from": "IN_PROGRESS",
      "to": "BLOCKED",
      "owner": "implementer",
      "workflow": "implementation.implement-ticket",
      "state_writer": "orchestrator"
    },
    {
      "from": "REVIEW_REQUIRED",
      "to": "PASS",
      "owner": "reviewer",
      "workflow": "review.record-review",
      "state_writer": "orchestrator"
    },
    {
      "from": "REVIEW_REQUIRED",
      "to": "REPAIR_REQUIRED",
      "owner": "reviewer",
      "workflow": "review.record-review",
      "state_writer": "orchestrator"
    },
    {
      "from": "REVIEW_REQUIRED",
      "to": "REPLAN_REQUIRED",
      "owner": "reviewer",
      "workflow": "review.record-review",
      "state_writer": "orchestrator"
    },
    {
      "from": "REVIEW_REQUIRED",
      "to": "BLOCKED",
      "owner": "reviewer",
      "workflow": "review.record-review",
      "state_writer": "orchestrator"
    },
    {
      "from": "REPAIR_REQUIRED",
      "to": "REVIEW_REQUIRED",
      "owner": "implementer",
      "workflow": "implementation.repair-ticket",
      "state_writer": "orchestrator"
    },
    {
      "from": "REPAIR_REQUIRED",
      "to": "REPLAN_REQUIRED",
      "owner": "planner",
      "workflow": "planning.replan",
      "state_writer": "orchestrator"
    },
    {
      "from": "REPLAN_REQUIRED",
      "to": "DRAFT",
      "owner": "planner",
      "workflow": "planning.replan",
      "state_writer": "orchestrator"
    },
    {
      "from": "REPLAN_REQUIRED",
      "to": "READY",
      "owner": "planner",
      "workflow": "planning.replan",
      "state_writer": "orchestrator"
    },
    {
      "from": "PASS",
      "to": "CANCELLED",
      "owner": "planner",
      "workflow": "planning.replan",
      "state_writer": "orchestrator"
    },
    {
      "from": "PASS",
      "to": "REVIEW_REQUIRED",
      "owner": "orchestrator",
      "workflow": "orchestration.reconcile-state",
      "causes": [
        "REVIEW_MISSING",
        "REVIEW_REPOSITORY_STALE",
        "VERIFICATION_MISSING",
        "VERIFICATION_REPOSITORY_STALE",
        "LEGACY_IDENTITY_UNVERIFIABLE"
      ],
      "state_writer": "orchestrator"
    },
    {
      "from": "PASS",
      "to": "REPLAN_REQUIRED",
      "owner": "orchestrator",
      "workflow": "orchestration.reconcile-state",
      "causes": [
        "PRODUCT_SOURCE_STALE",
        "ENGINEERING_SOURCE_STALE",
        "SPEC_SOURCE_STALE",
        "TICKET_SOURCE_STALE",
        "CONTRACT_INVALIDATED"
      ],
      "state_writer": "orchestrator"
    }
  ],
  "blocked_exit_targets": [
    "DRAFT",
    "READY",
    "IN_PROGRESS",
    "REVIEW_REQUIRED",
    "REPAIR_REQUIRED",
    "REPLAN_REQUIRED"
  ],
  "forbidden": [
    {
      "from": "DRAFT",
      "to": "PASS"
    },
    {
      "from": "READY",
      "to": "PASS"
    },
    {
      "from": "REPAIR_REQUIRED",
      "to": "PASS"
    }
  ]
}
