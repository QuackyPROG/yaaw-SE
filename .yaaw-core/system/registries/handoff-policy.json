{
  "schema": "yaaw.handoff-policy/v1",
  "workflows": {
    "prd.route": {
      "desired_intent": "CONTINUE_PRODUCT", "active_artifact": "product",
      "reads": ["product","state"], "writes": ["product"], "required_expertise": [], "ticket_expertise": false,
      "expected_output": "Current product intent or an explicit human-input/blocker result.",
      "result_vocabulary": ["READY","HUMAN_INPUT_REQUIRED","BLOCKED"]
    },
    "planning.route": {
      "desired_intent": "CONTINUE_PLANNING", "active_artifact": "engineering",
      "reads": ["product","engineering","engineering_research","spec","ticket","project_rule","repository","state"],
      "writes": ["engineering","engineering_research","spec","ticket","project_rule"], "required_expertise": [], "ticket_expertise": false,
      "expected_output": "Current engineering frontier readiness or one typed planning stop/result.",
      "result_vocabulary": ["READY","HUMAN_INPUT_REQUIRED","REPLAN","BLOCKED"]
    },
    "planning.create-spec": {
      "desired_intent": "CREATE_SPEC", "active_artifact": "engineering",
      "reads": ["product","engineering","engineering_research","project_rule","repository","state"], "writes": ["spec"],
      "required_expertise": [], "ticket_expertise": false,
      "expected_output": "One accepted specification for the current frontier or a typed prerequisite/stop result.",
      "result_vocabulary": ["SUCCESS","PRECONDITION_UNSATISFIED","BLOCKED"]
    },
    "planning.create-tickets": {
      "desired_intent": "CREATE_TICKETS", "active_artifact": "spec",
      "reads": ["product","engineering","engineering_research","spec","project_rule","repository","state"], "writes": ["ticket"],
      "required_expertise": [], "ticket_expertise": false,
      "expected_output": "Dependency-aware executable tickets for the accepted specification or a typed prerequisite/stop result.",
      "result_vocabulary": ["SUCCESS","PRECONDITION_UNSATISFIED","BLOCKED"]
    },
    "planning.replan": {
      "desired_intent": "REPLAN", "active_artifact": "ticket",
      "reads": ["product","engineering","engineering_research","spec","ticket","project_rule","repository","state"],
      "writes": ["engineering","engineering_research","spec","ticket","project_rule"], "required_expertise": [], "ticket_expertise": true,
      "expected_output": "Updated engineering contract and downstream admission state for the invalidated work.",
      "result_vocabulary": ["READY","HUMAN_INPUT_REQUIRED","BLOCKED"]
    },
    "implementation.implement-ticket": {
      "desired_intent": "IMPLEMENT", "active_artifact": "ticket",
      "reads": ["product","engineering","engineering_research","spec","ticket","project_rule","repository","evidence","review","application_files","state"],
      "writes": ["application_files","evidence"], "required_expertise": ["changeability"], "ticket_expertise": true,
      "expected_output": "Implementation-start evidence before mutation, bounded implementation, and verification evidence or a typed stop.",
      "result_vocabulary": ["VERIFICATION_PASS","VERIFICATION_FAIL","REPLAN_REQUIRED","PRECONDITION_UNSATISFIED","BLOCKED"]
    },
    "implementation.verify-ticket": {
      "desired_intent": "IMPLEMENT", "active_artifact": "ticket",
      "reads": ["product","engineering","spec","ticket","project_rule","repository","evidence","application_files","state"],
      "writes": ["evidence"], "required_expertise": ["changeability"], "ticket_expertise": true,
      "expected_output": "One immutable v3 implementation_verification evidence record.",
      "result_vocabulary": ["VERIFICATION_PASS","VERIFICATION_FAIL","IMPLEMENTATION_INCOMPLETE","REPLAN_REQUIRED","BLOCKED"]
    },
    "implementation.repair-ticket": {
      "desired_intent": "REPAIR", "active_artifact": "ticket",
      "reads": ["product","engineering","engineering_research","spec","ticket","project_rule","repository","evidence","review","application_files","state"],
      "writes": ["application_files","evidence"], "required_expertise": ["changeability"], "ticket_expertise": true,
      "expected_output": "Bounded repair plus fresh verification evidence and one legal typed result.",
      "result_vocabulary": ["VERIFICATION_PASS","VERIFICATION_FAIL","REPLAN_REQUIRED","BLOCKED"]
    },
    "review.review-ticket": {
      "desired_intent": "REVIEW", "active_artifact": "ticket",
      "reads": ["product","engineering","engineering_research","spec","ticket","project_rule","repository","evidence","review","application_files","state"],
      "writes": ["review"], "required_expertise": ["testing","changeability"], "ticket_expertise": true,
      "expected_output": "One immutable independent review round tied to the current contract, PASS verification, and repository basis.",
      "result_vocabulary": ["PASS","REPAIR","REPLAN","BLOCKED"]
    }
  }
}
