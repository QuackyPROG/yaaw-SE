    "implementation.repair-ticket": {
      "desired_intent": "REPAIR",
      "active_artifact": "ticket",
      "reads": ["product", "engineering", "engineering_research", "spec", "ticket", "project_rule", "repository", "evidence", "review", "application_files"],
      "writes": ["application_files", "evidence"],
      "required_expertise": ["changeability"],
      "ticket_expertise": true,
      "expected_output": "Bounded repair plus fresh verification evidence and one legal lifecycle result.",
      "result_vocabulary": ["REVIEW_REQUIRED", "REPLAN_REQUIRED", "BLOCKED"]
    },
    "review.review-ticket": {
      "desired_intent": "REVIEW",
      "active_artifact": "ticket",
      "reads": ["product", "engineering", "engineering_research", "spec", "ticket", "project_rule", "repository", "evidence", "review", "application_files", "state"],
      "writes": ["review"],
      "required_expertise": ["testing", "changeability"],
      "ticket_expertise": true,
      "expected_output": "One immutable independent review round tied to the current contract and repository basis.",
      "result_vocabulary": ["PASS", "REPAIR", "REPLAN", "BLOCKED"]
