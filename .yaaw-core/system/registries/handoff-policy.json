      "writes": ["engineering", "engineering_research", "spec", "ticket", "project_rule"],
      "required_expertise": [],
      "ticket_expertise": true,
      "expected_output": "Updated engineering contract and downstream admission state for the invalidated work.",
      "result_vocabulary": ["READY", "HUMAN_INPUT_REQUIRED", "BLOCKED"]
    },
    "implementation.implement-ticket": {
      "desired_intent": "IMPLEMENT",
      "active_artifact": "ticket",
      "reads": ["product", "engineering", "engineering_research", "spec", "ticket", "project_rule", "repository", "evidence", "review", "application_files"],
      "writes": ["application_files", "evidence"],
      "required_expertise": ["changeability"],
