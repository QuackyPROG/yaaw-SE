      "writes": ["engineering", "engineering_research", "spec", "ticket", "project_rule"],
      "required_expertise": [],
      "ticket_expertise": false,
      "expected_output": "Current engineering frontier readiness or one typed planning stop/result.",
      "result_vocabulary": ["READY", "HUMAN_INPUT_REQUIRED", "REPLAN", "BLOCKED"]
