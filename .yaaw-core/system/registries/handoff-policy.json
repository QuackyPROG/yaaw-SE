    "planning.create-spec": {
      "desired_intent": "CREATE_SPEC",
      "active_artifact": "engineering",
      "reads": ["product", "engineering", "engineering_research", "project_rule", "repository"],
      "writes": ["spec"],
      "required_expertise": [],
      "ticket_expertise": false,
      "expected_output": "One accepted specification for the current frontier or a typed prerequisite/stop result.",
      "result_vocabulary": ["SUCCESS", "PRECONDITION_UNSATISFIED", "BLOCKED"]
    },
    "planning.create-tickets": {
      "desired_intent": "CREATE_TICKETS",
      "active_artifact": "spec",
      "reads": ["product", "engineering", "engineering_research", "spec", "project_rule", "repository"],
