{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"yaaw.handoff/v1",
  "type":"object",
  "required":["schema","role","workflow","active_artifact","references","expertise","expected_output"],
  "properties":{
    "schema":{"const":"yaaw.handoff/v1"},
    "role":{"enum":["prd","planner","implementer","reviewer","orchestrator"]},
    "workflow":{"type":"string","minLength":1},
    "active_artifact":{"type":"string","minLength":1},
    "references":{"type":"array","items":{"type":"string"}},
    "expertise":{"type":"array","items":{"type":"string"}},
    "expected_output":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
