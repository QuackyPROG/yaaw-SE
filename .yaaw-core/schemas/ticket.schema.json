{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.ticket/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "revision",
    "spec",
    "spec_revision",
    "product_revision",
    "engineering_revision",
    "status",
    "dependencies",
    "decision_ids",
    "expertise"
  ],
  "properties": {
    "schema": {
      "const": "yaaw.ticket/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "spec": {
      "type": "string",
      "pattern": "^SPEC-[0-9]+$"
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "product_revision": {
      "type": "integer",
      "minimum": 1
    },
    "engineering_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "IN_PROGRESS",
        "REVIEW_REQUIRED",
        "REPAIR_REQUIRED",
        "REPLAN_REQUIRED",
        "BLOCKED",
        "PASS",
        "CANCELLED"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]+$"
      },
      "uniqueItems": true
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ENG-[0-9]+$"
      },
      "uniqueItems": true
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contract_version": {
      "type": "integer",
      "const": 2
    },
    "slice_type": {
      "enum": [
        "tracer",
        "prefactor",
        "expand",
        "migrate",
        "contract",
        "atomic"
      ]
    },
    "verification_mode": {
      "enum": [
        "red_green",
        "bug_repro",
        "characterization",
        "verification_only"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_version": {
            "const": 2
          }
        },
        "required": [
          "contract_version"
        ]
      },
      "then": {
        "required": [
          "slice_type",
          "verification_mode"
        ]
      }
    }
  ]
}
