{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.evidence/v2",
  "type": "object",
  "required": [
    "schema",
    "id",
    "ticket",
    "ticket_revision",
    "spec_revision",
    "kind",
    "repository",
    "workflow",
    "commands",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "yaaw.evidence/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^EVIDENCE-TASK-[0-9]+-V[0-9]+$"
    },
    "ticket": {
      "type": "string",
      "pattern": "^TASK-[0-9]+$"
    },
    "ticket_revision": {
      "type": "integer",
      "minimum": 1
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "implementation_verification",
        "repair_verification",
        "review_verification",
        "recovery"
      ]
    },
    "repository": {
      "allOf": [
        {
          "$ref": "repository-identity.schema.json"
        },
        {
          "properties": {
            "status": {
              "const": "READY"
            },
            "algorithm": {
              "const": "yaaw-worktree-v1"
            },
            "head_commit": {
              "type": "string"
            },
            "dirty": {
              "type": "boolean"
            },
            "worktree_digest": {
              "type": "string"
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
