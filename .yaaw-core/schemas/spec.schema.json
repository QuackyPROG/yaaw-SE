{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.spec/v1",
  "type": "object",
  "required": ["schema", "id", "revision", "status", "product_revision", "engineering_revision", "frontier_id", "decision_ids"],
  "properties": {
    "schema": {"const": "yaaw.spec/v1"},
    "id": {"type": "string", "pattern": "^SPEC-[0-9]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "ACCEPTED", "STALE", "SUPERSEDED"]},
    "product_revision": {"type": "integer", "minimum": 1},
    "engineering_revision": {"type": "integer", "minimum": 1},
    "frontier_id": {"type": "string", "minLength": 1},
    "decision_ids": {"type": "array", "items": {"type": "string", "pattern": "^ENG-[0-9]+$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
