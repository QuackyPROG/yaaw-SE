{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.review",
  "type": "object",
  "required": [
    "schema",
    "ticket",
    "round",
    "result",
    "ticket_revision",
    "spec_revision",
    "evidence"
  ],
  "properties": {
    "result": {
      "enum": [
        "PASS",
        "REPAIR",
        "REPLAN",
        "BLOCKED"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "review-v1.schema.json"
    },
    {
      "$ref": "review-v2.schema.json"
    }
  ]
}
