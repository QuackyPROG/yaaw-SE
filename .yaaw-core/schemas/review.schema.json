{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.review/v2",
  "type": "object",
  "required": ["schema", "ticket", "round", "result", "ticket_revision", "spec_revision", "repository_identity_schema", "reviewed_head_commit", "reviewed_branch", "reviewed_dirty_publishable", "reviewed_publishable_worktree_digest", "review_base_commit", "evidence"],
  "properties": {
    "schema": {"const": "yaaw.review/v2"},
    "ticket": {"type": "string", "pattern": "^TASK-[0-9]+$"},
    "round": {"type": "integer", "minimum": 1},
    "result": {"enum": ["PASS", "REPAIR", "REPLAN", "BLOCKED"]},
    "ticket_revision": {"type": "integer", "minimum": 1},
    "spec_revision": {"type": "integer", "minimum": 1},
    "repository_identity_schema": {"const": "yaaw.repository-identity/v2"},
    "reviewed_head_commit": {"type": "string", "minLength": 1},
    "reviewed_branch": {"type": "string", "minLength": 1},
    "reviewed_dirty_publishable": {"type": "boolean"},
    "reviewed_publishable_worktree_digest": {"type": "string", "minLength": 1},
    "review_base_commit": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}
