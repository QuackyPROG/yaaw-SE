{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.observed-state/v2",
  "type": "object",
  "required": ["schema", "repository", "transition_sequence", "claims", "artifacts", "inconsistencies", "candidate_actions"],
  "properties": {
    "schema": {"const": "yaaw.observed-state/v2"},
    "repository": {"$ref": "repository-identity.schema.json"},
    "transition_sequence": {"type": "integer", "minimum": 0},
    "claims": {"type": "object"},
    "artifacts": {"type": "object"},
    "inconsistencies": {"type": "array", "items": {"type": "string"}},
    "candidate_actions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
