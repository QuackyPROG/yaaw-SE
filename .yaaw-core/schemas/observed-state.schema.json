{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.observed-state/v3",
  "type": "object",
  "required": [
    "schema",
    "framework",
    "repository",
    "acceptance",
    "transition_sequence",
    "claims",
    "artifacts",
    "inconsistencies",
    "candidate_actions"
  ],
  "properties": {
    "schema": {
      "const": "yaaw.observed-state/v3"
    },
    "framework": {
      "type": "object",
      "required": [
        "yaaw_version",
        "installation_schema",
        "project_state_schema",
        "manifest_digest"
      ],
      "properties": {
        "yaaw_version": {
          "type": "string",
          "minLength": 1
        },
        "installation_schema": {
          "type": "integer",
          "minimum": 1
        },
        "project_state_schema": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "$ref": "repository-identity.schema.json"
    },
    "acceptance": {
      "type": "object",
      "required": [
        "active_ticket",
        "source_current",
        "review_present",
        "review_repository_current",
        "verification_repository_current",
        "stale_reason"
      ],
      "properties": {
        "active_ticket": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_current": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "review_present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "review_repository_current": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "verification_repository_current": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stale_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "transition_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "claims": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    },
    "inconsistencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
