{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.repository-identity/v2",
  "type": "object",
  "required": ["identity_schema", "head_commit", "branch", "dirty_publishable", "publishable_worktree_digest"],
  "properties": {
    "identity_schema": {"const": "yaaw.repository-identity/v2"},
    "head_commit": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "dirty_publishable": {"type": "boolean"},
    "publishable_worktree_digest": {"type": "string", "minLength": 1},
    "integration_branch": {"type": ["string", "null"]},
    "base_commit": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
