{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yaaw.evidence/v2",
  "type": "object",
  "required": [
    "schema",
    "id",
    "ticket",
    "ticket_revision",
    "spec_revision",
    "kind",
    "repository",
    "workflow",
    "commands",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "yaaw.evidence/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^EVIDENCE-TASK-[0-9]+-V[0-9]+$"
    },
    "ticket": {
      "type": "string",
      "pattern": "^TASK-[0-9]+$"
    },
    "ticket_revision": {
      "type": "integer",
      "minimum": 1
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "implementation_verification",
        "repair_verification",
        "review_verification",
        "recovery",
        "diagnosis"
      ]
    },
    "repository": {
      "$ref": "repository-identity.schema.json"
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ticket_contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "acceptance_ready": {
      "type": "boolean"
    },
    "verification": {
      "type": "object",
      "required": [
        "mode",
        "seams",
        "phases"
      ],
      "properties": {
        "mode": {
          "enum": [
            "red_green",
            "bug_repro",
            "characterization",
            "verification_only"
          ]
        },
        "seams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "interface",
              "oracle"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "interface": {
                "type": "string"
              },
              "oracle": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "phase",
              "command",
              "expected",
              "actual",
              "signal"
            ],
            "properties": {
              "phase": {
                "enum": [
                  "REPRO",
                  "RED",
                  "BASELINE",
                  "CHANGE",
                  "GREEN",
                  "FINAL"
                ]
              },
              "command": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "actual": {
                "type": "string"
              },
              "signal": {
                "type": "string"
              },
              "repository": {
                "$ref": "repository-identity.schema.json"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ticket_contract_version": {
            "const": 2
          }
        },
        "required": [
          "ticket_contract_version"
        ]
      },
      "then": {
        "required": [
          "acceptance_ready",
          "verification"
        ]
      }
    }
  ]
}
