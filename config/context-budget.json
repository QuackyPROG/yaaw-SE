{
  "schema": "yaaw.context-budget/v1",
  "purpose": "Pre-dispatch context-window budgets. Mandatory contract fields are preserved; optional retrieval evidence is packed by priority and evicted to references when the budget is full.",
  "estimator": {
    "strategy": "UTF8_HEURISTIC",
    "bytes_per_token": 3.0,
    "safety_factor": 1.15
  },
  "roles": {
    "default": {"max_window_tokens": 12000, "reserved_output_tokens": 2400, "max_retrieval_tokens": 3200, "max_single_evidence_tokens": 1000},
    "orchestrator": {"max_window_tokens": 12000, "reserved_output_tokens": 2200, "max_retrieval_tokens": 2600, "max_single_evidence_tokens": 900},
    "planner": {"max_window_tokens": 18000, "reserved_output_tokens": 3200, "max_retrieval_tokens": 5200, "max_single_evidence_tokens": 1400},
    "discovery": {"max_window_tokens": 14000, "reserved_output_tokens": 2400, "max_retrieval_tokens": 5000, "max_single_evidence_tokens": 1400},
    "implementer": {"max_window_tokens": 14000, "reserved_output_tokens": 3000, "max_retrieval_tokens": 4600, "max_single_evidence_tokens": 1200},
    "qa": {"max_window_tokens": 14000, "reserved_output_tokens": 2800, "max_retrieval_tokens": 4200, "max_single_evidence_tokens": 1200},
    "release-engineer": {"max_window_tokens": 10000, "reserved_output_tokens": 2200, "max_retrieval_tokens": 2400, "max_single_evidence_tokens": 900}
  },
  "level_multipliers": {
    "0": 0.55,
    "1": 0.75,
    "2": 1.0,
    "3": 1.0,
    "4": 1.2
  }
}
