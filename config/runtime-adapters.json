{
  "schema": "yaaw.runtime-adapters/v1",
  "adapters": {
    "codex": {
      "config": ".codex/config.toml",
      "validator": "scripts/validate_codex_runtime.py",
      "roles": ["orchestrator", "planner", "discovery", "implementer", "qa", "release-engineer"],
      "capabilities": ["root_only_delegation", "fresh_child_context", "bounded_parallelism", "model_neutral", "controller_admission", "trust_boundary_instructions"],
      "worktree_isolation": "CONTROLLER_MANAGED",
      "model_policy": "EXTERNAL_CAPABILITY_PROFILE"
    },
    "generic-command": {
      "config": "config/generic-command-runtime.json",
      "validator": "scripts/validate_generic_command_runtime.py",
      "roles": ["orchestrator", "planner", "discovery", "implementer", "qa", "release-engineer"],
      "capabilities": ["root_only_delegation", "fresh_child_context", "bounded_parallelism", "model_neutral", "controller_admission", "trust_boundary_instructions"],
      "worktree_isolation": "EXTERNAL_WRAPPER_MANAGED",
      "model_policy": "EXTERNAL_CAPABILITY_PROFILE"
    }
  }
}
