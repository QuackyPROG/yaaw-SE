{
  "schema": "yaaw.failure-examples/v1",
  "cases": [
    {
      "id": "STOP_AND_REPLAN",
      "kind": "repeated_failure",
      "signature": "same-auth-negative-test",
      "limit": 2,
      "attempts": 3,
      "expect_contains": "STOP_AND_REPLAN required"
    },
    {
      "id": "QA_REPAIR",
      "kind": "qa_gate",
      "ticket": {"id":"EX-QA","kind":"DELIVERY","status":"VERIFYING","level":2,"owner":"auth","blocked_by":[],"acceptance":["Rejects an expired session"],"qa":{"required":true}},
      "expect_contains": "qa_satisfied"
    },
    {
      "id": "STALE_EVIDENCE",
      "kind": "stale_evidence",
      "verification_id": "auth-negative",
      "recorded_commit": "abc",
      "current_commit": "def",
      "expect": ["stale evidence: auth-negative"]
    },
    {
      "id": "UNKNOWN_OWNER",
      "kind": "unknown_owner",
      "ticket": {"id":"EX-OWNER","kind":"DELIVERY","status":"READY","level":1,"owner":"UNKNOWN_OWNER","blocked_by":[],"acceptance":["Returns an observable response"],"qa":{"required":false}},
      "expect_contains": "unresolved ownership"
    }
  ]
}
