{
  "schema": "yaaw.domain-pack/v1",
  "name": "example-web-service",
  "requires_yaaw": {"min_harness_version": 4, "max_harness_version": null},
  "repository_map": ".yaaw/repository-map.json",
  "ownership": [
    {"pattern": "src/auth/**", "owner": "auth"},
    {"pattern": "src/payments/**", "owner": "payments"}
  ],
  "verification": [
    {"id": "unit", "command": "python -m unittest discover", "paths": ["src/**", "tests/**"], "required": true},
    {"id": "auth-negative", "command": "python -m unittest tests.auth_negative", "risks": ["auth"]}
  ],
  "risk_boundaries": [
    {"pattern": "src/auth/**", "minimum_level": 4, "qa": "HIGH_ASSURANCE", "tags": ["auth", "trust-boundary"]},
    {"pattern": "src/payments/**", "minimum_level": 4, "qa": "HIGH_ASSURANCE", "tags": ["payments", "financial"]}
  ],
  "environments": [
    {"id": "CI"},
    {"id": "STAGING", "promotion_authority": "HUMAN_RELEASE_AUTHORITY"},
    {"id": "PRODUCTION", "promotion_authority": "HUMAN_RELEASE_AUTHORITY"}
  ]
}
