    {"id":"retry-security-denial-never-blind-retries","type":"retry","input":{"failure":"SECURITY_DENIED","attempts":0},"expect":false},
    {"id":"authority-qa-can-write-qa-result","type":"authority","input":{"role":"qa","artifact":"DELIVERY_TICKET","field":"qa_result"},"expect":true},
    {"id":"authority-qa-cannot-write-implementation-evidence","type":"authority","input":{"role":"qa","artifact":"DELIVERY_TICKET","field":"implementation_evidence"},"expect":false},
    {"id":"authority-prd-status-is-human-semantic","type":"semantic_authority","input":{"artifact":"PRD","field":"status"},"expect":"HUMAN_PRODUCT_AUTHORITY"},
    {"id":"scope-allows-declared-paths","type":"scope","input":{"paths":["src/auth/login.py","tests/auth/test_login.py"],"allowed":["src/auth/**","tests/auth/**"],"forbidden":[]},"expect":[]},
    {"id":"scope-rejects-forbidden-secret-path","type":"scope","input":{"paths":["src/auth/secrets/key.py"],"allowed":["src/auth/**"],"forbidden":["src/auth/secrets/**"]},"expect":["FORBIDDEN src/auth/secrets/key.py"]},
    {"id":"scope-rejects-unrelated-subsystem","type":"scope","input":{"paths":["src/payments/x.py"],"allowed":["src/auth/**"],"forbidden":[]},"expect":["OUTSIDE_ALLOWED src/payments/x.py"]},
    {"id":"graph-detects-cycle","type":"graph","input":{"tickets":[{"id":"A","status":"DRAFT","blocked_by":["B"]},{"id":"B","status":"DRAFT","blocked_by":["A"]}]},"expect":{"missing_blockers":0,"cycles":1,"frontier":[]}},
    {"id":"graph-detects-missing-blocker","type":"graph","input":{"tickets":[{"id":"A","status":"DRAFT","blocked_by":["MISSING"]}]},"expect":{"missing_blockers":1,"cycles":0,"frontier":[]}},
    {"id":"graph-computes-ready-frontier","type":"graph","input":{"tickets":[{"id":"D","status":"DONE"},{"id":"R","status":"READY","blocked_by":["D"]}]},"expect":{"missing_blockers":0,"cycles":0,"frontier":["R"]}},
    {"id":"graph-long-horizon-does-not-need-llm-frontier-math","type":"long_horizon","input":{"count":100},"expect":{"tickets":100,"cycles":0,"frontier":["T001"]}},
    {"id":"history-done-ticket-cannot-be-reopened","type":"transition","input":{"ticket":{"id":"D","status":"DONE"},"target":"IN_PROGRESS"},"expect":{"allowed":false,"contains":"illegal transition"}},
    {"id":"state-ready-requires-admission-gates","type":"transition","input":{"ticket":{"id":"D","status":"DRAFT"},"target":"READY","context":{"owner_resolved":true,"blockers_done":true,"acceptance_bounded":false,"sources_current":true}},"expect":{"allowed":false,"contains":"acceptance_bounded"}},
    {"id":"state-ready-succeeds-with-full-gates","type":"transition","input":{"ticket":{"id":"D","status":"DRAFT"},"target":"READY","context":{"owner_resolved":true,"blockers_done":true,"acceptance_bounded":true,"sources_current":true}},"expect":{"allowed":true}},
    {"id":"evidence-fresh-pass-is-accepted","type":"evidence","input":{"recorded_commit":"abc","current_commit":"abc","recorded_fingerprints":{"spec":"1"},"current_fingerprints":{"spec":"1"}},"expect":[]},
