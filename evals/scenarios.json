    {"id":"evidence-stale-source-is-rejected","type":"evidence","input":{"recorded_commit":"abc","current_commit":"abc","recorded_fingerprints":{"spec":"1"},"current_fingerprints":{"spec":"2"}},"expect":["stale evidence: unit"]},
    {"id":"evidence-failing-command-is-rejected","type":"evidence","input":{"exit_code":1,"recorded_commit":"abc","current_commit":"abc"},"expect":["failing evidence: unit"]},
    {"id":"recovery-reconstructs-active-ticket-without-chat","type":"recovery","input":{"tickets":[{"id":"ACTIVE","status":"IN_PROGRESS","acceptance":["observable"]}]},"expect":{"active_work":"ACTIVE","source":"REPOSITORY"}},
    {"id":"repeated-failure-signature-forces-replan","type":"failure_signature","input":{"attempts":3,"limit":2,"signature":"same-test"},"expect":{"count":3,"outcome":"STOP_AND_REPLAN"}}
  ]
