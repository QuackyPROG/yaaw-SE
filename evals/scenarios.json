    {"id":"routing-auth-trust-is-high-assurance","type":"route","input":{"default_level":1,"security_trust_boundary":true},"expect":{"level":4,"qa":"HIGH_ASSURANCE"}},
    {"id":"routing-production-policy-is-not-always-l4","type":"route","input":{"default_level":1,"production_policy":true},"expect":{"level":3,"qa":"INDEPENDENT"}},
    {"id":"routing-irreversible-migration-is-l4","type":"route","input":{"default_level":1,"migration_scope":"IRREVERSIBLE"},"expect":{"level":4,"qa":"HIGH_ASSURANCE"}},
    {"id":"security-rm-rf-is-destructive","type":"command_risk","input":{"command":"rm -rf build"},"expect":"DESTRUCTIVE"},
    {"id":"security-package-install-mutates-dependencies","type":"command_risk","input":{"command":"npm install left-pad"},"expect":"DEPENDENCY_MUTATION"},
    {"id":"security-repository-content-cannot-instruct","type":"trust","input":{"source":"PROJECT_CONTENT_UNTRUSTED"},"expect":{"may_supply_instructions":false}},
