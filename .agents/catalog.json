{
  "version": 8,
  "description": "yaaw-SE v2 inventory. The public workflow surface is exactly five locked skills. Detailed methodology lives in _yaaw-core. Named agent profiles are intentionally absent; authority_roles are semantic write principals used by the deterministic controller and artifact policy.",
  "artifact_registry": ".agents/artifacts.json",
  "authority_roles": [
    {"id":"orchestrator","purpose":"Root workflow coordination, controller/frontier state and explicit product-drafting mechanics."},
    {"id":"planner","purpose":"Engineering planning, architecture decisions, SPECs and unresolved ticket-graph semantics."},
    {"id":"discovery","purpose":"Internal evidence authority for bounded discovery results; not a public skill or named agent."},
    {"id":"implementer","purpose":"Implementation evidence and contract-scoped mutation authority."},
    {"id":"qa","purpose":"Independent review/acceptance evidence authority."},
    {"id":"release-engineer","purpose":"Conditional serial delivery/integration authority retained by the deterministic delivery substrate; not a public skill or named agent."}
  ],
  "rules": [
    {"id":"source-of-truth","path":".agents/rules/source-of-truth.md"},
    {"id":"scope-and-blast-radius","path":".agents/rules/scope-and-blast-radius.md"},
    {"id":"documentation-and-memory","path":".agents/rules/documentation-and-memory.md"},
    {"id":"artifact-contracts","path":".agents/rules/artifact-contracts.md"},
    {"id":"quality-and-slop","path":".agents/rules/quality-and-slop.md"},
    {"id":"git-and-delivery","path":".agents/rules/git-and-delivery.md"}
  ],
  "skills": [
    {"id":"yaaw-prd","path":".agents/skills/yaaw-prd/SKILL.md","owner":"orchestrator","artifact_contract":"skills.yaaw-prd","invocation":"MANUAL_ONLY"},
    {"id":"yaaw-orchestrator","path":".agents/skills/yaaw-orchestrator/SKILL.md","owner":"orchestrator","artifact_contract":"skills.yaaw-orchestrator","invocation":"NORMAL_ENTRYPOINT"},
    {"id":"yaaw-planner","path":".agents/skills/yaaw-planner/SKILL.md","owner":"planner","artifact_contract":"skills.yaaw-planner","invocation":"ORCHESTRATOR_OR_EXPLICIT"},
    {"id":"yaaw-implement","path":".agents/skills/yaaw-implement/SKILL.md","owner":"implementer","artifact_contract":"skills.yaaw-implement","invocation":"ORCHESTRATOR_ADMITTED"},
    {"id":"yaaw-review","path":".agents/skills/yaaw-review/SKILL.md","owner":"qa","artifact_contract":"skills.yaaw-review","invocation":"ORCHESTRATOR_ADMITTED"}
  ],
  "validation": [
    {"id":"validate-workflow-assets","path":"scripts/validate_workflow_assets.py"},
    {"id":"validate-skill-metadata","path":"scripts/validate_skill_metadata.py"},
    {"id":"validate-semantics","path":"scripts/validate_semantics.py"},
    {"id":"validate-schemas","path":"scripts/validate_schemas.py"},
    {"id":"validate-schema-versions","path":"scripts/validate_schema_versions.py"},
    {"id":"validate-workflow-state","path":"scripts/validate_workflow_state.py"},
    {"id":"validate-runtime-adapters","path":"scripts/validate_runtime_adapters.py"},
    {"id":"validate-codex-runtime","path":"scripts/validate_codex_runtime.py"},
    {"id":"validate-generic-command-runtime","path":"scripts/validate_generic_command_runtime.py"},
    {"id":"verify-task-scope","path":"scripts/verify_task_scope.py"}
  ]
}
