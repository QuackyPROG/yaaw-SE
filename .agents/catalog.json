{
  "version": 7,
  "description": "yaaw-SE v2 inventory. Public workflow surface is intentionally small; detailed methodology lives in _yaaw-core while deterministic controller/runtime enforcement remains in scripts/config.",
  "artifact_registry": ".agents/artifacts.json",
  "agents": [
    {"id":"orchestrator","path":".agents/agents/orchestrator.md","artifact_contract":"agents.orchestrator","purpose":"Root control loop: observe durable state, resolve route/level, dispatch Planner/Implement/Review, and integrate controller state.","normal_write_scope":["tickets/**","routing metadata","docs/prd/** only during explicit yaaw-prd"]},
    {"id":"planner","path":".agents/agents/planner.md","artifact_contract":"agents.planner","purpose":"Technical lead/architect: turn accepted intent plus repository evidence into SPECs, engineering decisions, dependency graph, and READY tickets.","normal_write_scope":["docs/specs/**","docs/initiatives/**","docs/decisions/**","planning portions of tickets/**"]},
    {"id":"discovery","path":".agents/agents/discovery.md","artifact_contract":"agents.discovery","purpose":"Internal bounded evidence role available to Planner/Orchestrator when truth is missing; not a public v2 skill.","normal_write_scope":["discovery evidence in registered artifacts"]},
    {"id":"implementer","path":".agents/agents/implementer.md","artifact_contract":"agents.implementer","purpose":"Implement exactly one admitted bounded contract using applicable yaaw-core modules.","normal_write_scope":["contract-declared allowed write scope"]},
    {"id":"qa","path":".agents/agents/qa.md","artifact_contract":"agents.qa","purpose":"Fresh independent v2 Review role: classify actual implementation as PASS, REPAIR, REPLAN, or BLOCKED.","normal_write_scope":["review/QA result and evidence only"]},
    {"id":"release-engineer","path":".agents/agents/release-engineer.md","artifact_contract":"agents.release-engineer","purpose":"Internal conditional serial integration/delivery role retained from v1 enforcement; not a public v2 skill.","normal_write_scope":["delivery metadata, CI/release configuration when explicitly contracted"]}
  ],
  "rules": [
    {"id":"source-of-truth","path":".agents/rules/source-of-truth.md"},
    {"id":"scope-and-blast-radius","path":".agents/rules/scope-and-blast-radius.md"},
    {"id":"documentation-and-memory","path":".agents/rules/documentation-and-memory.md"},
    {"id":"artifact-contracts","path":".agents/rules/artifact-contracts.md"},
    {"id":"quality-and-slop","path":".agents/rules/quality-and-slop.md"},
    {"id":"git-and-delivery","path":".agents/rules/git-and-delivery.md"}
  ],
  "skills": [
    {"id":"yaaw-prd","path":".agents/skills/yaaw-prd/SKILL.md","owner":"orchestrator","artifact_contract":"skills.yaaw-prd","invocation":"MANUAL_ONLY"},
    {"id":"yaaw-orchestrator","path":".agents/skills/yaaw-orchestrator/SKILL.md","owner":"orchestrator","artifact_contract":"skills.yaaw-orchestrator","invocation":"NORMAL_ENTRYPOINT"},
    {"id":"yaaw-planner","path":".agents/skills/yaaw-planner/SKILL.md","owner":"planner","artifact_contract":"skills.yaaw-planner","invocation":"ORCHESTRATOR_OR_EXPLICIT"},
    {"id":"yaaw-implement","path":".agents/skills/yaaw-implement/SKILL.md","owner":"implementer","artifact_contract":"skills.yaaw-implement","invocation":"ORCHESTRATOR_ADMITTED"},
    {"id":"yaaw-review","path":".agents/skills/yaaw-review/SKILL.md","owner":"qa","artifact_contract":"skills.yaaw-review","invocation":"ORCHESTRATOR_ADMITTED"}
  ],
  "validation": [
    {"id":"validate-agent-assets","path":"scripts/validate_agent_assets.py"},
    {"id":"validate-skill-metadata","path":"scripts/validate_skill_metadata.py"},
    {"id":"validate-semantics","path":"scripts/validate_semantics.py"},
    {"id":"validate-schemas","path":"scripts/validate_schemas.py"},
    {"id":"validate-schema-versions","path":"scripts/validate_schema_versions.py"},
    {"id":"validate-workflow-state","path":"scripts/validate_workflow_state.py"},
    {"id":"validate-runtime-adapters","path":"scripts/validate_runtime_adapters.py"},
    {"id":"validate-codex-runtime","path":"scripts/validate_codex_runtime.py"},
    {"id":"validate-generic-command-runtime","path":"scripts/validate_generic_command_runtime.py"},
    {"id":"verify-task-scope","path":"scripts/verify_task_scope.py"}
  ]
}
