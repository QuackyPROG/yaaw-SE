{
  "version": 3,
  "purpose": "Canonical artifact addressing. Whole-file physical writers are narrowed by .agents/authority.json field-level semantic permissions.",
  "authority": ".agents/authority.json",
  "schemas": ".agents/schemas/",
  "special_owners": ["RESOLVED_CONTRACT_OWNER", "EXISTING_CANONICAL_OWNER", "HUMAN_PRODUCT_AUTHORITY"],
  "rules": {
    "no_ad_hoc_durable_destinations": true,
    "stable_ticket_paths_do_not_change_with_status": true,
    "local_agent_and_skill_contract_required": true,
    "field_level_authority_is_conjunctive_with_path_ownership": true,
    "overflow_artifacts_must_be_linked_from_primary": true,
    "completed_history_rewrite_forbidden": true,
    "accepted_prd_semantic_mutation_requires_explicit_human_authority": true,
    "domain_packs_may_extend_but_not_silently_redefine_generic_artifact_ids": true
  },
  "artifact_types": [
    {"id":"TASK_PROFILE","owner":"orchestrator","storage_kind":"EPHEMERAL_OR_INLINE","canonical_locator":"EPHEMERAL_CONTEXT or structured current work route","schema":".agents/schemas/task-profile.schema.json","template":null,"allowed_producers":["orchestrator"],"allowed_mutators":["orchestrator"]},
    {"id":"PRD","owner":"HUMAN_PRODUCT_AUTHORITY","storage_kind":"FILE","canonical_locator":"docs/prd/<slug>.md","template":"docs/templates/prd.md","allowed_producers":["orchestrator"],"allowed_mutators":["orchestrator"],"semantic_authority":"HUMAN_PRODUCT_AUTHORITY"},
    {"id":"SPEC","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/specs/<slug>.md","template":"docs/templates/spec.md","allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"INITIATIVE_MAP","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/initiatives/<initiative>/map.md","template":"docs/templates/initiative-map.md","allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"PLAN_DELTA","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/initiatives/<initiative>/deltas/<timestamp>-<slug>.md","template":"docs/templates/plan-delta.md","allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"ADR","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/decisions/<NNN>-<slug>.md","template":"docs/templates/adr.md","allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"ARCHITECTURE_DOC","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/architecture/<slug>.md","template":null,"allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"DISCOVERY_TICKET","owner":"planner","storage_kind":"FILE","canonical_locator":"tickets/<work>/<stable-id>-discovery-<slug>.md","schema":".agents/schemas/ticket.schema.json","template":"docs/templates/discovery-ticket.md","allowed_producers":["planner","orchestrator"],"allowed_mutators":["planner","orchestrator","discovery"]},
    {"id":"DECISION_TICKET","owner":"planner","storage_kind":"FILE","canonical_locator":"tickets/<work>/<stable-id>-decision-<slug>.md","schema":".agents/schemas/ticket.schema.json","template":"docs/templates/decision-ticket.md","allowed_producers":["planner","orchestrator"],"allowed_mutators":["planner","orchestrator"]},
    {"id":"DELIVERY_TICKET","owner":"planner","storage_kind":"FILE","canonical_locator":"tickets/<work>/<stable-id>-delivery-<slug>.md","schema":".agents/schemas/ticket.schema.json","template":"docs/templates/delivery-ticket.md","allowed_producers":["planner","orchestrator"],"allowed_mutators":["planner","orchestrator","implementer","qa","release-engineer"]},
    {"id":"TICKET_STATE","owner":"orchestrator","storage_kind":"STRUCTURED_METADATA","canonical_locator":"current ticket yaaw-json metadata: status/blocked_by","template":null,"allowed_producers":["orchestrator","planner"],"allowed_mutators":["orchestrator","planner","discovery","implementer","qa","release-engineer"]},
    {"id":"DISCOVERY_EVIDENCE","owner":"discovery","storage_kind":"INLINE_WITH_OVERFLOW","canonical_locator":"current DISCOVERY ticket#Evidence","overflow_locator":"docs/initiatives/<initiative>/evidence/<slug>.md","template":null,"allowed_producers":["discovery"],"allowed_mutators":["discovery"]},
    {"id":"CONTRACT_MUTATION","owner":"RESOLVED_CONTRACT_OWNER","storage_kind":"CONTRACT_SCOPE","canonical_locator":"current delivery metadata allowed_write plus field authority","template":null,"allowed_producers":["implementer"],"allowed_mutators":["implementer"]},
    {"id":"IMPLEMENTATION_HANDOFF","owner":"implementer","storage_kind":"INLINE_OR_EPHEMERAL","canonical_locator":"current DELIVERY ticket#Implementation evidence; L0 may remain ephemeral with Git/diff as durable truth","schema":".agents/schemas/handoff.schema.json","template":null,"allowed_producers":["implementer","orchestrator"],"allowed_mutators":["implementer","orchestrator"]},
    {"id":"QA_REPORT","owner":"qa","storage_kind":"INLINE_WITH_OVERFLOW","canonical_locator":"current DELIVERY ticket#QA result","overflow_locator":"docs/initiatives/<initiative>/qa/<ticket>-qa.md","schema":".agents/schemas/qa-report.schema.json","template":null,"allowed_producers":["qa"],"allowed_mutators":["qa"]},
    {"id":"DELIVERY_RECORD","owner":"release-engineer","storage_kind":"INLINE_PLUS_EXTERNAL_REFS","canonical_locator":"current DELIVERY ticket#Delivery with Git/CI/provider refs","template":null,"allowed_producers":["release-engineer"],"allowed_mutators":["release-engineer"]},
    {"id":"CANONICAL_DOC_UPDATE","owner":"EXISTING_CANONICAL_OWNER","storage_kind":"EXISTING_OWNER_PATH","canonical_locator":"smallest existing canonical path resolved by ownership/domain pack/docs index","template":null,"allowed_producers":["orchestrator","planner","discovery","implementer","qa","release-engineer"],"allowed_mutators":["orchestrator","planner","discovery","implementer","qa","release-engineer"]}
  ],
  "contracts": {
    "agents": {
      "orchestrator": {"reads":["root policy","current work","controller state","Git state","smallest relevant context"],"produces":["TASK_PROFILE","TICKET_STATE"],"may_mutate":["TASK_PROFILE","PRD","TICKET_STATE","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","IMPLEMENTATION_HANDOFF","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["unapproved PRD semantics","planner-only plan semantics","contract-external product code","QA acceptance","manufactured delivery evidence"]},
      "planner": {"reads":["task profile","accepted intent/decisions","maps/tickets/evidence","relevant implementation context"],"produces":["SPEC","INITIATIVE_MAP","PLAN_DELTA","ADR","ARCHITECTURE_DOC","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"may_mutate":["SPEC","INITIATIVE_MAP","PLAN_DELTA","ADR","ARCHITECTURE_DOC","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["accepted PRD semantics","general product implementation","QA acceptance","rewriting completed history"]},
      "discovery": {"reads":["discovery question","canonical sources","code/tests/runtime evidence"],"produces":["DISCOVERY_EVIDENCE"],"may_mutate":["DISCOVERY_EVIDENCE","DISCOVERY_TICKET","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["product intent","ticket graph structure","product implementation"]},
      "implementer": {"reads":["bounded delivery contract","canonical sources","scope/invariants","implementation neighborhood","verification contract"],"produces":["CONTRACT_MUTATION","IMPLEMENTATION_HANDOFF"],"may_mutate":["CONTRACT_MUTATION","IMPLEMENTATION_HANDOFF","DELIVERY_TICKET","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["PRD semantics","ticket graph structure","material acceptance","unapproved trust/provider boundaries","QA result"]},
      "qa": {"reads":["actual diff","originating contract","verification evidence","ownership/authority rules","affected docs"],"produces":["QA_REPORT"],"may_mutate":["QA_REPORT","DELIVERY_TICKET","TICKET_STATE","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["same-context product repair","accepted intent","manufactured evidence"]},
      "release-engineer": {"reads":["accepted work","actual diff","verification/QA state","release policy","observed CI/provider state"],"produces":["DELIVERY_RECORD"],"may_mutate":["DELIVERY_RECORD","DELIVERY_TICKET","TICKET_STATE","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["missing QA state","product implementation","unapproved promotion","fabricated deployment status"]}
    },
    "skills": {
      "prd-creation": {"reads":["explicit human product intent","existing PRD","accepted constraints"],"produces":["PRD"],"may_mutate":["PRD"],"forbidden_mutations":["automatic invocation","accepted revision without authority","implementation"]},
      "intake-routing": {"reads":["root policy","router","ownership/domain pack","Git state","likely target context"],"produces":["TASK_PROFILE"],"may_mutate":["TASK_PROFILE"],"forbidden_mutations":["product code","material graph mutation"]},
      "progressive-planning": {"reads":["task profile","accepted intent/ADRs","maps/tickets/evidence","relevant code"],"produces":["SPEC","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET"],"may_mutate":["SPEC","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["accepted PRD semantics","general implementation","fictional fog precision"]},
      "plan-delta": {"reads":["trigger evidence","map/spec/tickets","completed/unresolved graph","diff state"],"produces":["PLAN_DELTA","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"may_mutate":["PLAN_DELTA","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["accepted PRD semantics","silent widening","completed history rewrite"]},
      "bug-diagnosis": {"reads":["bug report","reproduction seam","code/tests/runtime"],"produces":["DISCOVERY_EVIDENCE"],"may_mutate":["DISCOVERY_EVIDENCE","DISCOVERY_TICKET"],"forbidden_mutations":["shotgun edits","scope expansion"]},
      "implementation": {"reads":["bounded contract","scope/surface/invariants","sources/tests/docs","verification seam"],"produces":["CONTRACT_MUTATION","IMPLEMENTATION_HANDOFF"],"may_mutate":["CONTRACT_MUTATION","IMPLEMENTATION_HANDOFF","DELIVERY_TICKET","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["ticket graph","material acceptance","out-of-contract paths"]},
      "qa-regression": {"reads":["actual diff","contract","verification evidence","authority/ownership","affected docs"],"produces":["QA_REPORT"],"may_mutate":["QA_REPORT","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["same-context product repair","manufactured pass"]},
      "documentation-impact": {"reads":["changed fact","truth hierarchy","docs index","ownership","artifacts"],"produces":["CANONICAL_DOC_UPDATE"],"may_mutate":["CANONICAL_DOC_UPDATE"],"forbidden_mutations":["duplicate canonical memory"]},
      "architecture-change": {"reads":["architecture/code/tests","accepted ADRs","destination","ownership","migration/trust constraints"],"produces":["ADR","ARCHITECTURE_DOC","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET"],"may_mutate":["ADR","ARCHITECTURE_DOC","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["implementation before decisions","unapproved architecture truth"]}
    }
  }
}
