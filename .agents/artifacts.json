{
  "version": 2,
  "purpose": "Canonical artifact-addressing and mutation-authority registry for yaaw-SE agents and skills. Resolve this registry before creating or relocating durable workflow artifacts.",
  "special_owners": ["RESOLVED_CONTRACT_OWNER", "EXISTING_CANONICAL_OWNER", "HUMAN_PRODUCT_AUTHORITY"],
  "rules": {
    "no_ad_hoc_durable_destinations": true,
    "local_agent_and_skill_contract_required": true,
    "overflow_artifacts_must_be_linked_from_primary": true,
    "completed_history_rewrite_forbidden": true,
    "accepted_prd_semantic_mutation_requires_explicit_human_authority": true,
    "domain_packs_may_extend_but_not_silently_redefine_generic_artifact_ids": true
  },
  "artifact_types": [
    {"id":"TASK_PROFILE","owner":"orchestrator","storage_kind":"EPHEMERAL_OR_INLINE","canonical_locator":"EPHEMERAL_CONTEXT or current durable ticket#Route","template":null,"allowed_producers":["orchestrator"],"allowed_mutators":["orchestrator"]},
    {"id":"PRD","owner":"HUMAN_PRODUCT_AUTHORITY","storage_kind":"FILE","canonical_locator":"docs/prd/<slug>.md","template":"docs/templates/prd.md","allowed_producers":["orchestrator"],"allowed_mutators":["orchestrator"]},
    {"id":"SPEC","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/specs/<slug>.md","template":"docs/templates/spec.md","allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"INITIATIVE_MAP","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/initiatives/<initiative>/map.md","template":"docs/templates/initiative-map.md","allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"PLAN_DELTA","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/initiatives/<initiative>/deltas/<timestamp>-<slug>.md","template":"docs/templates/plan-delta.md","allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"ADR","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/decisions/<NNN>-<slug>.md","template":"docs/templates/adr.md","allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"ARCHITECTURE_DOC","owner":"planner","storage_kind":"FILE","canonical_locator":"docs/architecture/<slug>.md","template":null,"allowed_producers":["planner"],"allowed_mutators":["planner"]},
    {"id":"DISCOVERY_TICKET","owner":"planner","storage_kind":"FILE","canonical_locator":"tickets/<work>/<NN>-discovery-<slug>.md","template":"docs/templates/discovery-ticket.md","allowed_producers":["planner","orchestrator"],"allowed_mutators":["planner","orchestrator","discovery"]},
    {"id":"DECISION_TICKET","owner":"planner","storage_kind":"FILE","canonical_locator":"tickets/<work>/<NN>-decision-<slug>.md","template":"docs/templates/decision-ticket.md","allowed_producers":["planner","orchestrator"],"allowed_mutators":["planner","orchestrator"]},
    {"id":"DELIVERY_TICKET","owner":"planner","storage_kind":"FILE","canonical_locator":"tickets/<work>/<NN>-delivery-<slug>.md","template":"docs/templates/delivery-ticket.md","allowed_producers":["planner","orchestrator"],"allowed_mutators":["planner","orchestrator","implementer","qa","release-engineer"]},
    {"id":"TICKET_STATE","owner":"orchestrator","storage_kind":"INLINE_SECTION","canonical_locator":"current ticket#Status/Blocked by/Frontier metadata","template":null,"allowed_producers":["orchestrator","planner"],"allowed_mutators":["orchestrator","planner","qa","release-engineer"]},
    {"id":"DISCOVERY_EVIDENCE","owner":"discovery","storage_kind":"INLINE_WITH_OVERFLOW","canonical_locator":"current DISCOVERY ticket#Evidence","overflow_locator":"docs/initiatives/<initiative>/evidence/<slug>.md","template":null,"allowed_producers":["discovery"],"allowed_mutators":["discovery"]},
    {"id":"CONTRACT_MUTATION","owner":"RESOLVED_CONTRACT_OWNER","storage_kind":"CONTRACT_SCOPE","canonical_locator":"current delivery contract allowed write scope","template":null,"allowed_producers":["implementer"],"allowed_mutators":["implementer"]},
    {"id":"IMPLEMENTATION_HANDOFF","owner":"implementer","storage_kind":"INLINE_OR_EPHEMERAL","canonical_locator":"current DELIVERY ticket#Implementation evidence; L0 may remain ephemeral with Git/diff as durable truth","template":null,"allowed_producers":["implementer","orchestrator"],"allowed_mutators":["implementer","orchestrator"]},
    {"id":"QA_REPORT","owner":"qa","storage_kind":"INLINE_WITH_OVERFLOW","canonical_locator":"current DELIVERY ticket#QA","overflow_locator":"docs/initiatives/<initiative>/qa/<ticket>-qa.md","template":null,"allowed_producers":["qa"],"allowed_mutators":["qa"]},
    {"id":"DELIVERY_RECORD","owner":"release-engineer","storage_kind":"INLINE_PLUS_EXTERNAL_REFS","canonical_locator":"current DELIVERY ticket#Delivery with Git/CI/PR refs","template":null,"allowed_producers":["release-engineer"],"allowed_mutators":["release-engineer"]},
    {"id":"CANONICAL_DOC_UPDATE","owner":"EXISTING_CANONICAL_OWNER","storage_kind":"EXISTING_OWNER_PATH","canonical_locator":"smallest existing canonical path resolved by .agents/ownership.json and docs/index.md","template":null,"allowed_producers":["orchestrator","planner","discovery","implementer","qa","release-engineer"],"allowed_mutators":["orchestrator","planner","discovery","implementer","qa","release-engineer"]}
  ],
  "contracts": {
    "agents": {
      "orchestrator": {"reads":["AGENTS.md","docs/index.md","current work item","relevant accepted PRD when one exists",".agents/router.json",".agents/artifacts.json when durable output is involved",".agents/ownership.json when ownership is involved","Git state","smallest relevant code/docs/tests"],"produces":["TASK_PROFILE","TICKET_STATE"],"may_mutate":["TASK_PROFILE","PRD","TICKET_STATE","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","IMPLEMENTATION_HANDOFF","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["PRD except during explicit manual prd-creation invocation","unapproved product decisions","planner-only PLAN_DELTA/ADR/spec semantics","contract-external product code","QA acceptance","manufactured delivery evidence"]},
      "planner": {"reads":["current task profile/work item","relevant accepted PRD when one exists","accepted ADRs/architecture","active specs/initiative maps/tickets","relevant evidence","smallest relevant code/tests"],"produces":["SPEC","INITIATIVE_MAP","PLAN_DELTA","ADR","ARCHITECTURE_DOC","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"may_mutate":["SPEC","INITIATIVE_MAP","PLAN_DELTA","ADR","ARCHITECTURE_DOC","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["accepted PRD semantics","general implementation code","implementation completion claims","QA acceptance","rewriting completed history"]},
      "discovery": {"reads":["exact discovery question/ticket","relevant canonical docs","relevant code/tests/runtime evidence","accepted decisions affecting the question"],"produces":["DISCOVERY_EVIDENCE"],"may_mutate":["DISCOVERY_EVIDENCE","DISCOVERY_TICKET","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["product intent","ticket graph structure","unapproved architecture","product code except explicitly contracted reversible probes"]},
      "implementer": {"reads":["current delivery contract/ticket","relevant PRD/ADR/spec/map references","allowed/forbidden and expected change surface","preservation invariants","immediate code/test/interface neighborhood","verification requirements"],"produces":["CONTRACT_MUTATION","IMPLEMENTATION_HANDOFF"],"may_mutate":["CONTRACT_MUTATION","IMPLEMENTATION_HANDOFF","DELIVERY_TICKET","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["PRD semantics","ticket graph structure","material acceptance changes","new unapproved owners/dependencies/providers/trust boundaries","QA result"]},
      "qa": {"reads":["actual diff/comparison","originating ticket/spec/decision/map/PRD","verification evidence","ownership/artifact rules","affected canonical docs"],"produces":["QA_REPORT"],"may_mutate":["QA_REPORT","DELIVERY_TICKET","TICKET_STATE","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["repairing reviewed product code in the same QA context","changing accepted product intent","manufacturing evidence"]},
      "release-engineer": {"reads":["accepted work item","actual diff","verification/QA state","branch/promotion policy","CI/release state"],"produces":["DELIVERY_RECORD"],"may_mutate":["DELIVERY_RECORD","DELIVERY_TICKET","TICKET_STATE","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["missing QA state","product implementation","unapproved main/production authority","fabricated deployment status"]}
    },
    "skills": {
      "prd-creation": {"reads":["explicit human product intent","existing relevant PRD if any","accepted product/business constraints","smallest repository context needed to avoid contradiction"],"produces":["PRD"],"may_mutate":["PRD"],"forbidden_mutations":["automatic invocation","accepted PRD revision without explicit human authority","engineering ticket graph","product implementation"]},
      "intake-routing": {"reads":["AGENTS.md","docs/index.md","current work item",".agents/router.json",".agents/ownership.json","Git state","smallest likely target context"],"produces":["TASK_PROFILE"],"may_mutate":["TASK_PROFILE"],"forbidden_mutations":["product code","planning graph beyond minimum routing artifact"]},
      "progressive-planning": {"reads":["task profile","relevant accepted PRD when one exists","accepted ADRs/architecture","current specs/maps/tickets","evidence","smallest relevant implementation context"],"produces":["SPEC","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET"],"may_mutate":["SPEC","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["accepted PRD semantics","general product implementation","fictional precision for fog"]},
      "ticket-graph": {"reads":["approved spec/map/decisions","current ticket graph","ownership","evidence"],"produces":["DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"may_mutate":["DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["product code","rewriting completed ticket history"]},
      "plan-delta": {"reads":["trigger evidence","current map/spec/tickets","completed and unresolved graph state","current implementation/diff state"],"produces":["PLAN_DELTA","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"may_mutate":["PLAN_DELTA","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["accepted PRD semantics","silent scope widening","cosmetic rewrite of completed history"]},
      "bug-diagnosis": {"reads":["bug report/ticket","reproduction seam","relevant code/tests/runtime evidence"],"produces":["DISCOVERY_EVIDENCE"],"may_mutate":["DISCOVERY_EVIDENCE","DISCOVERY_TICKET"],"forbidden_mutations":["shotgun product edits","scope expansion without replan"]},
      "implementation": {"reads":["current bounded contract","allowed/forbidden and expected change surface","preservation invariants","relevant source/tests/docs","verification seam"],"produces":["CONTRACT_MUTATION","IMPLEMENTATION_HANDOFF"],"may_mutate":["CONTRACT_MUTATION","IMPLEMENTATION_HANDOFF","DELIVERY_TICKET","CANONICAL_DOC_UPDATE"],"forbidden_mutations":["ticket graph","material acceptance","out-of-contract paths"]},
      "qa-regression": {"reads":["actual diff","originating contract","verification evidence","ownership/artifact registry","affected docs"],"produces":["QA_REPORT"],"may_mutate":["QA_REPORT","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["same-context product repair","manufactured pass"]},
      "documentation-impact": {"reads":["changed fact","source-of-truth hierarchy","docs/index.md",".agents/ownership.json",".agents/artifacts.json"],"produces":["CANONICAL_DOC_UPDATE"],"may_mutate":["CANONICAL_DOC_UPDATE"],"forbidden_mutations":["duplicate memory artifact when a canonical owner already exists"]},
      "architecture-change": {"reads":["current architecture/code/tests","accepted ADRs","problem/destination","ownership","migration/trust constraints"],"produces":["ADR","ARCHITECTURE_DOC","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET"],"may_mutate":["ADR","ARCHITECTURE_DOC","INITIATIVE_MAP","DISCOVERY_TICKET","DECISION_TICKET","DELIVERY_TICKET","TICKET_STATE"],"forbidden_mutations":["implementation before required decisions","unapproved architecture truth"]}
    }
  }
}
