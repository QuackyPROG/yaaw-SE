{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/task-profile.schema.json",
  "title": "yaaw-SE Task Profile",
  "type": "object",
  "required": ["schema", "shape", "level", "goal", "acceptance", "owner", "qa", "next_action"],
  "properties": {
    "schema": {"const": "yaaw.task-profile/v1"},
    "shape": {"type": "string", "minLength": 1},
    "level": {"type": "integer", "minimum": 0, "maximum": 4},
    "goal": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string", "minLength": 1},
    "uncertainty": {"enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
    "blast_radius": {"enum": ["LOCAL", "SUBSYSTEM", "MULTI_SUBSYSTEM", "SYSTEM", "UNKNOWN"]},
    "reversibility": {"enum": ["HIGH", "MEDIUM", "LOW", "IRREVERSIBLE", "UNKNOWN"]},
    "qa": {"enum": ["SELF_VERIFY", "INDEPENDENT", "HIGH_ASSURANCE"]},
    "next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
