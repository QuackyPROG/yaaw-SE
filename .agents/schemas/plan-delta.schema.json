{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/plan-delta.schema.json",
  "title": "yaaw-SE PLAN_DELTA metadata",
  "type": "object",
  "required": ["schema", "id", "initiative", "triggering_work", "date", "action"],
  "properties": {
    "schema": {"const": "yaaw.plan-delta/v1"},
    "id": {"type": "string", "minLength": 1},
    "initiative": {"type": "string", "minLength": 1},
    "triggering_work": {"type": "string", "minLength": 1},
    "date": {"type": "string"},
    "action": {"enum": ["CONTINUE", "AMEND_UNRESOLVED", "SPLIT", "INSERT_PREREQUISITE", "ADD_FOLLOWUP", "ADD_DISCOVERY", "ADD_DECISION", "RESEQUENCE", "PROMOTE_LEVEL", "SUPERSEDE_UNRESOLVED", "CORRECT_COMPLETED_WORK"]},
    "human_authority_required": {"type": "boolean"}
  },
  "additionalProperties": false
}
