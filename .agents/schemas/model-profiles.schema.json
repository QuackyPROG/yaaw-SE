{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/model-profiles.schema.json",
  "type": "object",
  "required": ["schema", "version", "reasoning_order", "profiles", "fallback_policy", "qa_diversification"],
  "properties": {
    "schema": {"const": "yaaw.model-profiles/v2"},
    "version": {"const": 2},
    "reasoning_order": {"type": "array", "items": {"enum": ["low", "medium", "high", "max"]}, "minItems": 4, "uniqueItems": true},
    "profiles": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "required": ["model", "min_reasoning", "requires"], "properties": {"model": {"type": "string"}, "min_reasoning": {"enum": ["low", "medium", "high", "max"]}, "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false}}},
    "fallback_policy": {"type": "object"},
    "qa_diversification": {"type": "object"},
    "purpose": {"type": "string"},
    "rule": {"type": "string"}
  },
  "additionalProperties": false
}
