{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/spec.schema.json",
  "title": "yaaw-SE SPEC metadata",
  "type": "object",
  "required": ["schema", "id", "status", "owner"],
  "properties": {
    "schema": {"const": "yaaw.spec/v1"},
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "APPROVED", "SUPERSEDED"]},
    "owner": {"type": "string", "minLength": 1},
    "initiative": {"type": ["string", "null"]},
    "prd_ref": {"type": ["string", "null"]},
    "revision": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
