{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/initiative-map.schema.json",
  "title": "yaaw-SE initiative map metadata",
  "type": "object",
  "required": ["schema", "id", "level", "status"],
  "properties": {
    "schema": {"const": "yaaw.initiative-map/v1"},
    "id": {"type": "string", "minLength": 1},
    "level": {"enum": [3, 4]},
    "status": {"enum": ["ACTIVE", "BLOCKED", "DONE", "SUPERSEDED"]},
    "spec_ref": {"type": ["string", "null"]},
    "prd_ref": {"type": ["string", "null"]},
    "revision": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
