{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/agent-eval.schema.json",
  "title": "yaaw-SE Agent Loop Evaluation Manifest",
  "type": "object",
  "required": ["schema", "id", "task", "attempts", "k", "outcome_grader", "trace_grader", "thresholds"],
  "properties": {
    "schema": {"const": "yaaw.agent-eval/v1"},
    "id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "attempts": {"type": "integer", "minimum": 1, "maximum": 1000},
    "k": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "outcome_grader": {
      "type": "object",
      "properties": {
        "expected_exit_code": {"type": "integer"},
        "output_contains": {"type": "array", "items": {"type": "string"}},
        "output_excludes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "trace_grader": {
      "type": "object",
      "properties": {
        "require_events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbid_events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "require_correlation": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "min_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "min_trace_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "max_policy_violations": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "properties": {
        "sequence": {"type": "array", "minItems": 1, "items": {"type": "boolean"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
