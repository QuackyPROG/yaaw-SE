{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/adr.schema.json",
  "title": "yaaw-SE ADR metadata",
  "type": "object",
  "required": ["schema", "id", "status", "decision_owner", "date"],
  "properties": {
    "schema": {"const": "yaaw.adr/v1"},
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED"]},
    "decision_owner": {"type": "string", "minLength": 1},
    "date": {"type": "string"},
    "supersedes": {"type": ["string", "null"]},
    "approval_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
