{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/domain-pack.schema.json",
  "title": "yaaw-SE Domain Pack",
  "type": "object",
  "required": ["schema", "name", "requires_yaaw"],
  "properties": {
    "schema": {"const": "yaaw.domain-pack/v1"},
    "name": {"type": "string", "minLength": 1},
    "requires_yaaw": {"type": "object", "properties": {"min_harness_version": {"type": "integer", "minimum": 1}, "max_harness_version": {"type": ["integer", "null"], "minimum": 1}}, "required": ["min_harness_version"]},
    "repository_map": {"type": "string"},
    "ownership": {"type": "array", "items": {"type": "object", "required": ["pattern", "owner"], "properties": {"pattern": {"type": "string"}, "owner": {"type": "string"}, "co_owners": {"type": "array", "items": {"type": "string"}}, "override": {"type": "boolean"}}}},
    "verification": {"type": "array", "items": {"type": "object", "required": ["id", "command"], "properties": {"id": {"type": "string"}, "command": {"type": "string"}, "paths": {"type": "array", "items": {"type": "string"}}, "risks": {"type": "array", "items": {"type": "string"}}, "required": {"type": "boolean"}, "override": {"type": "boolean"}}}},
    "risk_boundaries": {"type": "array", "items": {"type": "object", "required": ["pattern", "minimum_level"], "properties": {"pattern": {"type": "string"}, "minimum_level": {"type": "integer", "minimum": 0, "maximum": 4}, "qa": {"enum": ["SELF_VERIFY", "INDEPENDENT", "HIGH_ASSURANCE"]}, "tags": {"type": "array", "items": {"type": "string"}}, "override": {"type": "boolean"}}}},
    "specialists": {"type": "array", "items": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["agent", "skill"]}, "path": {"type": "string"}, "override": {"type": "boolean"}}}},
    "environments": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "promotion_authority": {"type": "string"}, "override": {"type": "boolean"}}}}
  },
  "additionalProperties": true
}
