{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/event.schema.json",
  "title": "yaaw-SE Workflow Event",
  "type": "object",
  "required": ["schema", "event", "work_id", "actor", "timestamp"],
  "properties": {
    "schema": {"const": "yaaw.event/v1"},
    "event": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "span_id": {"type": "string", "minLength": 1},
    "parent_span_id": {"type": "string", "minLength": 1},
    "decision": {"type": "string"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "reason": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"anyOf": [{"required": ["run_id"]}, {"required": ["trace_id"]}, {"required": ["span_id"]}]},
      "then": {"required": ["run_id", "trace_id", "span_id"]}
    }
  ],
  "additionalProperties": true
}
