{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/delivery-record.schema.json",
  "title": "yaaw-SE Delivery Record",
  "type": "object",
  "required": ["work_id", "base_sha", "head_sha", "stage", "environment", "qa_result", "provider_observed"],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "minLength": 1},
    "head_sha": {"type": "string", "minLength": 1},
    "stage": {"enum": ["IMPLEMENTED", "VERIFIED", "ACCEPTED", "COMMITTED", "INTEGRATED", "DEPLOYED"]},
    "environment": {"type": "string", "minLength": 1},
    "qa_result": {"enum": ["PASS", "QA_NOT_REQUIRED_BY_ROUTE"]},
    "provider_observed": {"type": "boolean"},
    "rollback_ref": {"type": ["string", "null"]},
    "ci_ref": {"type": ["string", "null"]},
    "integration_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
