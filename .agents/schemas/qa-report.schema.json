{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/qa-report.schema.json",
  "title": "yaaw-SE QA Report",
  "type": "object",
  "required": ["schema", "ticket", "result", "findings", "verification", "residual_risks"],
  "properties": {
    "schema": {"const": "yaaw.qa-report/v1"},
    "ticket": {"type": "string"},
    "result": {"enum": ["PASS", "REPAIR_REQUIRED", "STOP_AND_REPLAN"]},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "summary"], "properties": {"id": {"type": "string"}, "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "summary": {"type": "string"}}, "additionalProperties": true}},
    "verification": {"type": "array", "items": {"type": "object"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
