{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaaw.dev/schemas/ticket.schema.json",
  "title": "yaaw-SE Ticket Metadata",
  "type": "object",
  "required": ["schema", "id", "kind", "status", "level", "owner", "blocked_by", "acceptance"],
  "properties": {
    "schema": {"const": "yaaw.ticket/v1"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9_-]*-[0-9A-Za-z._-]+$"},
    "kind": {"enum": ["DISCOVERY", "DECISION", "DELIVERY"]},
    "status": {"enum": ["DRAFT", "BLOCKED", "READY", "IN_PROGRESS", "VERIFYING", "DONE", "SUPERSEDED", "CANCELLED"]},
    "level": {"type": "integer", "minimum": 0, "maximum": 4},
    "parent": {"type": ["string", "null"]},
    "owner": {"type": "string", "minLength": 1},
    "blocked_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "acceptance": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "qa": {"type": "object", "properties": {"required": {"type": "boolean"}, "profile": {"type": "string"}}, "required": ["required"], "additionalProperties": true},
    "allowed_write": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forbidden_write": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_change_surface": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_fingerprints": {"type": "object", "additionalProperties": {"type": "string"}},
    "risk": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "side_effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
