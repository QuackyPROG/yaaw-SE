{
  "version": 4,
  "default_owner": "UNKNOWN_OWNER",
  "unknown_owner_route": "bounded discovery then reclassify before mutation",
  "artifact_registry": ".agents/artifacts.json",
  "entries": [
    {"pattern":"AGENTS.md","owner":"orchestrator","risk":"HIGH","notes":"root navigation/policy"},
    {"pattern":"README.md","owner":"orchestrator","co_owner":"qa","risk":"MEDIUM","notes":"public harness claims must match executable behavior and maturity evidence"},
    {"pattern":".gitignore","owner":"orchestrator","risk":"LOW","notes":"harness-local ephemeral/runtime exclusions"},
    {"pattern":".agents/router.json","owner":"orchestrator","risk":"HIGH","notes":"hot routing policy"},
    {"pattern":".agents/catalog.json","owner":"orchestrator","risk":"HIGH","notes":"agent asset inventory"},
    {"pattern":".agents/ownership.json","owner":"orchestrator","risk":"HIGH","notes":"path ownership architecture"},
    {"pattern":".agents/artifacts.json","owner":"orchestrator","co_owner":"planner","risk":"HIGH","notes":"artifact addressing and mutation authority"},
    {"pattern":".agents/authority.json","owner":"orchestrator","co_owner":"qa","risk":"HIGH","notes":"field-level semantic mutation authority"},
    {"pattern":".agents/schemas/**","owner":"orchestrator","co_owner":"qa","risk":"HIGH","notes":"machine contracts; schema changes require semantic validation"},
    {"pattern":".agents/agents/orchestrator.md","owner":"orchestrator","risk":"HIGH"},
    {"pattern":".agents/agents/planner.md","owner":"planner","risk":"HIGH"},
    {"pattern":".agents/agents/discovery.md","owner":"discovery","risk":"HIGH"},
    {"pattern":".agents/agents/implementer.md","owner":"implementer","risk":"HIGH"},
    {"pattern":".agents/agents/qa.md","owner":"qa","risk":"HIGH"},
    {"pattern":".agents/agents/release-engineer.md","owner":"release-engineer","risk":"HIGH"},
    {"pattern":".agents/rules/**","owner":"orchestrator","risk":"HIGH"},
    {"pattern":".agents/skills/prd-creation/**","owner":"orchestrator","risk":"HIGH","notes":"manual-only skill; artifact semantic authority remains HUMAN_PRODUCT_AUTHORITY"},
    {"pattern":".agents/skills/intake-routing/**","owner":"orchestrator","risk":"MEDIUM"},
    {"pattern":".agents/skills/progressive-planning/**","owner":"planner","risk":"MEDIUM"},
    {"pattern":".agents/skills/ticket-graph/**","owner":"planner","risk":"MEDIUM"},
    {"pattern":".agents/skills/plan-delta/**","owner":"planner","risk":"HIGH"},
    {"pattern":".agents/skills/bug-diagnosis/**","owner":"discovery","risk":"MEDIUM"},
    {"pattern":".agents/skills/implementation/**","owner":"implementer","risk":"MEDIUM"},
    {"pattern":".agents/skills/qa-regression/**","owner":"qa","risk":"HIGH"},
    {"pattern":".agents/skills/documentation-impact/**","owner":"orchestrator","risk":"MEDIUM"},
    {"pattern":".agents/skills/architecture-change/**","owner":"planner","risk":"HIGH"},
    {"pattern":"docs/prd/**","owner":"orchestrator","risk":"HIGH","notes":"mechanical path owner only; semantic intent belongs to HUMAN_PRODUCT_AUTHORITY and changes require manual prd-creation"},
    {"pattern":"docs/architecture/**","owner":"planner","risk":"HIGH"},
    {"pattern":"docs/decisions/**","owner":"planner","risk":"HIGH"},
    {"pattern":"docs/specs/**","owner":"planner","risk":"MEDIUM"},
    {"pattern":"docs/initiatives/**","owner":"planner","risk":"MEDIUM","notes":"initiative maps/deltas plus linked evidence/QA overflow; artifact-level authority is refined by .agents/artifacts.json"},
    {"pattern":"docs/workflow/**","owner":"orchestrator","risk":"HIGH"},
    {"pattern":"docs/templates/**","owner":"orchestrator","co_owner":"planner","risk":"MEDIUM"},
    {"pattern":"docs/index.md","owner":"orchestrator","risk":"MEDIUM"},
    {"pattern":"docs/ownership.md","owner":"orchestrator","risk":"HIGH"},
    {"pattern":"docs/domain-packs.md","owner":"orchestrator","risk":"MEDIUM"},
    {"pattern":"tickets/**","owner":"orchestrator","co_owner":"planner","risk":"MEDIUM","notes":"artifact registry refines field/section mutation authority for discovery/implementation/QA/release evidence"},
    {"pattern":"scripts/yaaw/**","owner":"orchestrator","co_owner":"qa","risk":"HIGH","notes":"deterministic workflow controller; semantic changes require independent harness QA"},
    {"pattern":"scripts/yaaw_cli.py","owner":"orchestrator","co_owner":"qa","risk":"HIGH"},
    {"pattern":"scripts/run_evals.py","owner":"qa","co_owner":"orchestrator","risk":"HIGH","notes":"adversarial conformance runner"},
    {"pattern":"scripts/report_metrics.py","owner":"orchestrator","co_owner":"qa","risk":"MEDIUM","notes":"diagnostic metric reporting only; metrics do not define intent"},
    {"pattern":"scripts/validate_*","owner":"qa","co_owner":"orchestrator","risk":"HIGH"},
    {"pattern":"scripts/verify_*","owner":"qa","co_owner":"orchestrator","risk":"HIGH"},
    {"pattern":"tests/harness/**","owner":"qa","co_owner":"orchestrator","risk":"HIGH","notes":"deterministic harness regression suite"},
    {"pattern":"examples/**","owner":"orchestrator","co_owner":"qa","risk":"MEDIUM","notes":"executable/reference harness examples"},
    {"pattern":"evals/**","owner":"qa","co_owner":"orchestrator","risk":"HIGH","notes":"adversarial and long-horizon harness evaluation assets"},
    {"pattern":".codex/**","owner":"orchestrator","risk":"HIGH"},
    {"pattern":"config/**","owner":"orchestrator","risk":"MEDIUM"},
    {"pattern":".github/workflows/**","owner":"release-engineer","co_owner":"qa","risk":"HIGH"}
  ]
}
